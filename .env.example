# Leave all of these unset to run in offline_fallback mode (no external calls, no key needed).

# Option A: Azure OpenAI (matches the target deployment platform)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=<your-chat-deployment-name>

# Option B: plain OpenAI (used only if the Azure vars above are not set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
